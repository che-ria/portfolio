# Copy to .env.local for development, and set the same keys in the hosting
# provider's environment for production.

# Public origin of the media bucket (Cloudflare R2 behind a custom subdomain).
# Origin only: no trailing slash, no /portfolio suffix.
# Leave unset to serve images from local files in public/ instead.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Canonical site origin, used for metadata, sitemap.xml and robots.txt.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL when unset,
# so it only needs setting for a custom domain.
NEXT_PUBLIC_SITE_URL=https://example.com
